<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="NewDataSet" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
  <xs:element name="factura">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="infoTributaria" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ambiente" type="xs:string" minOccurs="0" />
              <xs:element name="tipoEmision" type="xs:string" minOccurs="0" />
              <xs:element name="razonSocial" type="xs:string" minOccurs="0" />
              <xs:element name="nombreComercial" type="xs:string" minOccurs="0" />
              <xs:element name="ruc" type="xs:string" minOccurs="0" />
              <xs:element name="claveAcceso" type="xs:string" minOccurs="0" />
              <xs:element name="codDoc" type="xs:string" minOccurs="0" />
              <xs:element name="estab" type="xs:string" minOccurs="0" />
              <xs:element name="ptoEmi" type="xs:string" minOccurs="0" />
              <xs:element name="secuencial" type="xs:string" minOccurs="0" />
              <xs:element name="dirMatriz" type="xs:string" minOccurs="0" />
              <xs:element name="contribuyenteRimpe" type="xs:string" minOccurs="0" />
              <xs:element name="fechaAutorizacion" type="xs:string" minOccurs="0" />
              <xs:element name="fechaEmision" type="xs:string" minOccurs="0" />
              <xs:element name="autorizacion" type="xs:string" minOccurs="0" />
              <xs:element name="logoByte" type="xs:base64Binary" minOccurs="0" />
              <xs:element name="codBarrClaveAcceso" type="xs:base64Binary" minOccurs="0" />
              <xs:element name="agenteRetencion" type="xs:string" minOccurs="0" />
              <xs:element name="regimenMicroempresas" type="xs:string" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="infoFactura" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fechaEmision" type="xs:string" minOccurs="0" />
              <xs:element name="dirEstablecimiento" type="xs:string" minOccurs="0" />
              <xs:element name="obligadoContabilidad" type="xs:string" minOccurs="0" />
              <xs:element name="tipoIdentificacionComprador" type="xs:string" minOccurs="0" />
              <xs:element name="razonSocialComprador" type="xs:string" minOccurs="0" />
              <xs:element name="identificacionComprador" type="xs:string" minOccurs="0" />
              <xs:element name="totalSinImpuestos" type="xs:decimal" minOccurs="0" />
              <xs:element name="totalDescuento" type="xs:decimal" minOccurs="0" />
              <xs:element name="propina" type="xs:decimal" minOccurs="0" />
              <xs:element name="importeTotal" type="xs:decimal" minOccurs="0" />
              <xs:element name="moneda" type="xs:string" minOccurs="0" />
              <xs:element name="contribuyenteEspecial" type="xs:string" minOccurs="0" />
              <xs:element name="totalConImpuestos" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="totalImpuesto" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="codigo" type="xs:int" minOccurs="0" />
                          <xs:element name="codigoPorcentaje" type="xs:string" minOccurs="0" />
                          <xs:element name="baseImponible" type="xs:decimal" minOccurs="0" />
                          <xs:element name="valor" type="xs:decimal" minOccurs="0" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="pagos" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="pago" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="formaPago" type="xs:string" minOccurs="0" />
                          <xs:element name="total" type="xs:string" minOccurs="0" />
                          <xs:element name="plazo" type="xs:string" minOccurs="0" />
                          <xs:element name="unidadTiempo" type="xs:string" minOccurs="0" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="detalles" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="detalle" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="codigoPrincipal" type="xs:string" minOccurs="0" />
                    <xs:element name="codigoAuxiliar" type="xs:string" minOccurs="0" />
                    <xs:element name="descripcion" type="xs:string" minOccurs="0" />
                    <xs:element name="unidadMedida" type="xs:string" minOccurs="0" />
                    <xs:element name="cantidad" type="xs:decimal" minOccurs="0" />
                    <xs:element name="precioUnitario" type="xs:decimal" minOccurs="0" />
                    <xs:element name="descuento" type="xs:decimal" minOccurs="0" />
                    <xs:element name="precioTotalSinImpuesto" type="xs:decimal" minOccurs="0" />
                    <xs:element name="iva" type="xs:decimal" minOccurs="0" />
                    <xs:element name="impuestos" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="impuesto" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="codigo" type="xs:string" minOccurs="0" />
                                <xs:element name="codigoPorcentaje" type="xs:string" minOccurs="0" />
                                <xs:element name="tarifa" type="xs:string" minOccurs="0" />
                                <xs:element name="baseImponible" type="xs:string" minOccurs="0" />
                                <xs:element name="valor" type="xs:string" minOccurs="0" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="infoAdicional" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="campoAdicional" nillable="true" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent msdata:ColumnName="campoAdicional_Text" msdata:Ordinal="1">
                    <xs:extension base="xs:string">
                      <xs:attribute name="nombre" type="xs:string" />
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="version" type="xs:string" />
    </xs:complexType>
  </xs:element>
  <xs:element name="NewDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="factura" />
        <xs:element name="detAdicional">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="valor" type="xs:string" minOccurs="0" />
              <xs:element name="nombre" type="xs:string" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="totalDetaImpuesto">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="index" type="xs:short" minOccurs="0" />
              <xs:element name="codigo" type="xs:string" minOccurs="0" />
              <xs:element name="descripcionImpuesto" type="xs:string" minOccurs="0" />
              <xs:element name="codigoPorcentaje" type="xs:string" minOccurs="0" />
              <xs:element name="baseImponible" type="xs:decimal" minOccurs="0" />
              <xs:element name="tarifa" type="xs:decimal" minOccurs="0" />
              <xs:element name="valor" type="xs:decimal" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>